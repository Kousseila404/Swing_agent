# ══════════════════════════════════════════════════════════
#  SwingQuant — Variables d'environnement
#  Copier en .env et remplir les valeurs réelles
# ══════════════════════════════════════════════════════════

# ── API / Sécurité ─────────────────────────────────────────
# Token Bearer pour protéger les endpoints POST sensibles
# Laisser vide pour désactiver l'authentification (dev uniquement)
API_TOKEN=change_me_random_secret

# Origines CORS autorisées (séparées par des virgules)
# En prod : mettre uniquement ton domaine
CORS_ORIGINS=http://localhost:5173,https://ton-domaine.com

# ── Intelligence Artificielle ──────────────────────────────
# Clé Anthropic pour l'analyse IA (claude-sonnet-4-6 + haiku)
ANTHROPIC_API_KEY=sk-ant-...

# ── Notifications Telegram ─────────────────────────────────
# Créer un bot via @BotFather, récupérer le chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_CHAT_ID=-100...

# ── Data Providers (TITAN — Data Adapters) ────────────────
# Clé Financial Modeling Prep pour les ratios fondamentaux
# (ROE, Debt/Equity, PE, EV/EBITDA, margins, FCF).
#   Free tier : 250 requêtes / jour — FMPProvider cappe à 240
#   pour laisser un coussin. Absent → fallback yfinance.
#   Inscription : https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Clé Polygon.io pour les prix ajustés daily
# (Momentum RA, SMA200, RSI — consommé par universe_engine
# et sector_metrics).
#   Free tier : 5 requêtes / minute — PolygonProvider applique
#   un token-bucket in-memory. Absent → fallback yfinance.
#   Inscription : https://polygon.io/
MARKET_DATA_API_KEY=

# ── Broker ─────────────────────────────────────────────────
# Mode d'exécution : paper | live | disabled
BROKER_MODE=paper

# Alpaca Markets (paper trading ou live)
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
# URL paper : https://paper-api.alpaca.markets
# URL live  : https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets
