[run]
source = modules
omit =
    modules/__init__.py
    # AlpacaBroker requires live API keys — tested via integration env
    modules/alpaca_*.py

[report]
exclude_lines =
    # Patterns standards
    pragma: no cover
    def __repr__
    def __str__
    raise NotImplementedError
    if __name__ == .__main__.:
    # Self-tests intégrés non-pertinents (legacy)
    def _run_tests
    # Classes abstraites
    @abstractmethod
    class .*\(Protocol\):
    # Type-checking uniquement
    if TYPE_CHECKING:
precision = 1
skip_covered = false
show_missing = true
