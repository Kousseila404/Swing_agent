# SwingQuant TITAN — coverage config
# Baseline 2026-09-17 : 64.5% sur modules/. Seuil CI = 60% pour absorber
# les fluctuations, à durcir progressivement (objectif 70%).
[run]
source = modules
branch = True
omit =
    */tests/*
    */__pycache__/*
    */venv/*
    */scripts/*
    modules/__init__.py
    modules/cli_*.py
    # AlpacaBroker requires live API keys — tested via integration env
    modules/alpaca_*.py

[report]
fail_under = 60
show_missing = True
skip_covered = False
precision = 1
exclude_also =
    pragma: no cover
    def __repr__
    def __str__
    raise NotImplementedError
    if __name__ == .__main__.:
    # Self-tests intégrés non-pertinents (legacy)
    def _run_tests
    # Classes abstraites
    @abstractmethod
    class .*\(Protocol\):
    # Type-checking uniquement
    if TYPE_CHECKING:
    \.\.\.
    if False:
    if 0:

[xml]
output = coverage.xml
